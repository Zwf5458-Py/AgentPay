# AgentPay 环境变量配置样例
# 复制此文件为 .env 并按需修改

# 链上结算
CHAIN_ID=31337
ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 安全
INTERNAL_SECRET=your-internal-secret-here

# Stripe 法币轨（空或 mock_ 前缀为 mock 模式）
STRIPE_SECRET_KEY=mock_stripe_key

# Redis 分布式限流
REDIS_URL=redis://localhost:6379
RATE_LIMIT=5
RATE_BURST=10
AGENT_LOCK_TTL=30

# Agent
ELIZA_AGENT_URL=http://127.0.0.1:3002
AA_BRIDGE_URL=http://127.0.0.1:3001/aa/settle
