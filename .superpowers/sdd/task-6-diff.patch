+# Build Stage
+FROM golang:1.21-alpine AS builder
+WORKDIR /app
+COPY go.mod go.sum ./
+RUN go mod download
+COPY . .
+RUN CGO_ENABLED=0 GOOS=linux go build -o gateway ./cmd/gateway/main.go
+
+# Production Stage
+FROM alpine:latest
+WORKDIR /app
+COPY --from=builder /app/gateway .
+EXPOSE 8080
+CMD ["./gateway"]
