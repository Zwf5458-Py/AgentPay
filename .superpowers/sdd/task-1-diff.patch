         if (_paymentToken == address(0) || _validationRegistry == address(0) || _settler == address(0)) {
             revert InvalidAddress();
         }
         paymentToken = IERC20(_paymentToken);
         validationRegistry = IValidationRegistry(_validationRegistry);
